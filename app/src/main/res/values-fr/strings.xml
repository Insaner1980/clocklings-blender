    <string name="l_viisarit_title">Deux aiguilles</string>
    <string name="l_viisarit_desc">Que montre chaque aiguille ?</string>
    <string name="l_viisarit_p1a">Cette horloge a deux aiguilles.</string>
    <string name="l_viisarit_p1b">La petite aiguille rose est l’aiguille des heures. Elle indique l’heure en cours.</string>
    <string name="l_viisarit_p2a">La grande aiguille bleue est l’aiguille des minutes. Elle indique les minutes.</string>
    <string name="l_viisarit_p3a">Quand le temps passe, les aiguilles avancent du 1 vers le 2, puis le 3, et continuent autour du cadran.</string>
    <string name="l_viisarit_p3b">C’est ce qu’on appelle le sens des aiguilles d’une montre.</string>
    <string name="l_viisarit_q">Quelle aiguille indique les heures ?</string>
    <string name="l_viisarit_c1">La petite aiguille rose</string>
    <string name="l_viisarit_c2">La grande aiguille bleue</string>
    <string name="l_viisarit_hint">L’aiguille des heures est la plus petite, celle qui est rose.</string>

    <string name="l_kierros_title">Un tour complet</string>
    <string name="l_kierros_desc">Que se passe-t-il en une heure ?</string>
    <string name="l_kierros_p1a">La grande aiguille avance autour du cadran.</string>
    <string name="l_kierros_p1b">Un tour complet dure une heure.</string>
    <string name="l_kierros_say_start">Il est trois heures.</string>
    <string name="l_kierros_say_go">La grande aiguille commence son tour.</string>
    <string name="l_kierros_say_end">Il est maintenant quatre heures. Une heure est passée !</string>
    <string name="l_kierros_p2a">Regarde maintenant la petite aiguille !</string>
    <string name="l_kierros_p2b">Pendant que la grande aiguille fait un tour complet, la petite aiguille avance d’un seul nombre.</string>
    <string name="l_kierros_say_moved">La petite aiguille est passée du 3 au 4.</string>
    <string name="l_kierros_p3a">Une heure dure 60\u00A0minutes.</string>
    <string name="l_kierros_p3b">Il y a 60\u00A0graduations de minutes sur le bord. La grande aiguille avance d’une graduation par minute.</string>
    <string name="l_kierros_say_hour">60\u00A0minutes font une heure.</string>
    <string name="l_kierros_q">Combien de temps passe quand la grande aiguille fait un tour complet ?</string>
    <string name="l_kierros_c1">Une heure</string>
    <string name="l_kierros_c2">Une minute</string>
    <string name="l_kierros_c3">Un jour</string>
    <string name="l_kierros_hint">La petite aiguille a avancé d’un nombre. Cela fait une heure.</string>

    <string name="l_tasan_title">Heures pile</string>
    <string name="l_tasan_desc">La grande aiguille pointe vers le haut</string>
    <string name="l_tasan_p1a">Quand la grande aiguille pointe tout en haut, sur le 12, c’est une heure pile.</string>
    <string name="l_tasan_p2a">Regarde la petite aiguille pour trouver l’heure.</string>
    <string name="l_tasan_p2b">Ici, elle pointe sur le 3. Il est donc trois heures.</string>
    <string name="l_tasan_p3a">Découvrons d’autres heures pile.</string>
    <string name="l_tasan_p3b">La grande aiguille reste en haut. La petite aiguille nous indique l’heure.</string>
    <string name="l_tasan_q">Quelle heure est-il ?</string>
    <string name="l_tasan_c1">Neuf heures</string>
    <string name="l_tasan_c2">Douze heures</string>
    <string name="l_tasan_c3">Trois heures</string>
    <string name="l_tasan_hint">La grande aiguille est en haut. Regarde la petite aiguille rose pour trouver l’heure.</string>

    <string name="l_puoli_title">Demi-heures</string>
    <string name="l_puoli_desc">La grande aiguille pointe vers le bas</string>
    <string name="l_puoli_p1a">Après un demi-tour du cadran, la grande aiguille pointe vers le bas, sur le 6.</string>
    <string name="l_puoli_p1b">Une demi-heure est passée. Cela fait 30\u00A0minutes.</string>
    <string name="l_puoli_say_half">Une demi-heure est passée.</string>
    <string name="l_puoli_p2a">La petite aiguille a quitté le 3 mais n’a pas encore atteint le 4.</string>
    <string name="l_puoli_p2b">Elle est à mi-chemin entre les deux.</string>
    <string name="l_puoli_p3a">On dit trois heures et demie : une demi-heure est passée depuis trois heures.</string>
    <string name="l_puoli_p3b">En chiffres, il est 3:30.</string>
    <string name="l_puoli_say_digits">Trois heures et demie s’écrit 3:30.</string>
    <string name="l_puoli_p4a">Avant et demie, on nomme l’heure que la petite aiguille a dépassée.</string>
    <string name="l_puoli_p4b">Entre le 7 et le 8, il est sept heures et demie.</string>
    <string name="l_puoli_q">Quelle heure est-il ?</string>
    <string name="l_puoli_c1">Cinq heures et demie</string>
    <string name="l_puoli_c2">Quatre heures et demie</string>
    <string name="l_puoli_c3">Six heures</string>
    <string name="l_puoli_hint">La petite aiguille a dépassé le 5 et est à mi-chemin du 6. Nomme l’heure qu’elle a dépassée.</string>

    <string name="l_vartti_title">Quarts d’heure</string>
    <string name="l_vartti_desc">Un quart d’heure</string>
    <string name="l_vartti_p1a">Divise une heure en quatre parts égales. Chaque part est un quart d’heure.</string>
    <string name="l_vartti_p1b">Un quart d’heure dure 15\u00A0minutes.</string>
    <string name="l_vartti_say_four">Quatre quarts font une heure.</string>
    <string name="l_vartti_p2a">Quand la grande aiguille atteint le 3, un quart d’heure est passé.</string>
    <string name="l_vartti_p2b">Ici, on dit trois heures et quart.</string>
    <string name="l_vartti_p3a">Quand la grande aiguille atteint le 9, il reste un quart d’heure avant l’heure pile suivante.</string>
    <string name="l_vartti_p3b">Ici, on dit quatre heures moins le quart.</string>
    <string name="l_vartti_q">Quelle heure est-il ?</string>
    <string name="l_vartti_c1">Sept heures moins le quart</string>
    <string name="l_vartti_c2">Six heures et quart</string>
    <string name="l_vartti_c3">Six heures moins le quart</string>
    <string name="l_vartti_hint">La grande aiguille est sur le 9. Il reste un quart d’heure. Quelle heure vient ensuite ?</string>

    <string name="l_ylivaille_title">Minutes passées et restantes</string>
    <string name="l_ylivaille_desc">Les deux côtés du cadran</string>
    <string name="l_ylivaille_p1a">Sur la moitié droite, on lit l’heure puis les minutes.</string>
    <string name="l_ylivaille_p1b">On compte les minutes passées depuis l’heure pile.</string>
    <string name="l_ylivaille_p2a">Sur la moitié gauche, on peut dire moins.</string>
    <string name="l_ylivaille_p2b">On compte les minutes qui restent avant l’heure pile suivante.</string>
    <string name="l_ylivaille_p3a">Pour les minutes passées, on nomme l’heure que la petite aiguille a dépassée.</string>
    <string name="l_ylivaille_p3b">Avec moins, on nomme l’heure suivante.</string>
    <string name="l_ylivaille_q">Quelle heure est-il ?</string>
    <string name="l_ylivaille_c1">Quatre heures dix</string>
    <string name="l_ylivaille_c2">Quatre heures moins dix</string>
    <string name="l_ylivaille_c3">Cinq heures moins dix</string>
    <string name="l_ylivaille_hint">La grande aiguille est à droite. Compte les minutes depuis l’heure que la petite aiguille a dépassée.</string>

    <string name="l_viisi_title">De cinq en cinq</string>
    <string name="l_viisi_desc">Nombres et minutes</string>
    <string name="l_viisi_p1a">La grande aiguille met cinq minutes pour passer d’un nombre au suivant.</string>
    <string name="l_viisi_p1b">Le nombre 1 indique 5\u00A0minutes, le 2 en indique 10, et ainsi de suite.</string>
    <string name="l_viisi_p2a">Compte de cinq en cinq : 5, 10, 15, 20.</string>
    <string name="l_viisi_p2b">Au nombre 4, 20\u00A0minutes sont passées. On lit l’heure suivie de vingt.</string>
    <string name="l_viisi_p3a">Continue à compter de cinq en cinq, avant et après la demi-heure.</string>
    <string name="l_viisi_p3b">Au 5, on lit trois heures vingt-cinq. Au 7, quatre heures moins vingt-cinq.</string>
    <string name="l_viisi_q">Quelle heure est-il ?</string>
    <string name="l_viisi_c1">Neuf heures moins vingt</string>
    <string name="l_viisi_c2">Huit heures vingt</string>
    <string name="l_viisi_c3">Neuf heures moins dix</string>
    <string name="l_viisi_hint">Au nombre 8, 40\u00A0minutes sont passées. Il reste 20\u00A0minutes avant l’heure suivante.</string>

    <string name="l_minuutit_title">Minutes précises</string>
    <string name="l_minuutit_desc">Les petites graduations</string>
    <string name="l_minuutit_p1a">Chaque petite graduation du cadran représente une minute.</string>
    <string name="l_minuutit_p1b">Il y a 5\u00A0minutes entre deux nombres voisins. Pour lire une heure précise, on dit l’heure puis les minutes.</string>
    <string name="l_minuutit_p2a">Pars du nombre juste avant la grande aiguille. Compte les petites graduations supplémentaires en avançant.</string>
    <string name="l_minuutit_p2b">Le nombre 2 indique 10\u00A0minutes. Deux graduations de plus font 10 + 2 = 12\u00A0minutes.</string>
