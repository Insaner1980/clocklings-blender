    <string name="l_viisarit_title">Zwei Zeiger</string>
    <string name="l_viisarit_desc">Was zeigt welcher Zeiger?</string>
    <string name="l_viisarit_p1a">Diese Uhr hat zwei Zeiger.</string>
    <string name="l_viisarit_p1b">Der kurze rosa Zeiger ist der Stundenzeiger. Er zeigt, in welcher Stunde wir sind.</string>
    <string name="l_viisarit_p2a">Der lange blaue Zeiger ist der Minutenzeiger. Er zeigt die Minuten.</string>
    <string name="l_viisarit_p3a">Die Zeiger bewegen sich mit der Zeit von der 1 zur 2, dann zur 3 und immer weiter im Kreis.</string>
    <string name="l_viisarit_p3b">Die Zeiger bewegen sich im Uhrzeigersinn.</string>
    <string name="l_viisarit_q">Welcher Zeiger zeigt die Stunde?</string>
    <string name="l_viisarit_c1">Der kurze rosa Zeiger</string>
    <string name="l_viisarit_c2">Der lange blaue Zeiger</string>
    <string name="l_viisarit_hint">Der Stundenzeiger ist der kürzere, rosa Zeiger.</string>

    <string name="l_kierros_title">Einmal herum</string>
    <string name="l_kierros_desc">Was passiert in einer Stunde?</string>
    <string name="l_kierros_p1a">Der lange Zeiger wandert immer weiter um die Uhr.</string>
    <string name="l_kierros_p1b">Eine ganze Runde dauert eine Stunde.</string>
    <string name="l_kierros_say_start">Es ist drei Uhr.</string>
    <string name="l_kierros_say_go">Der lange Zeiger beginnt seine Runde.</string>
    <string name="l_kierros_say_end">Jetzt ist es vier Uhr. Eine Stunde ist vergangen!</string>
    <string name="l_kierros_p2a">Schau jetzt auf den kurzen Zeiger!</string>
    <string name="l_kierros_p2b">Während der lange Zeiger einmal ganz herumwandert, rückt der kurze Zeiger nur eine Zahl weiter.</string>
    <string name="l_kierros_say_moved">Der kurze Zeiger ist von der 3 zur 4 gewandert.</string>
    <string name="l_kierros_p3a">Eine Stunde hat 60\u00A0Minuten.</string>
    <string name="l_kierros_p3b">Am Rand sind 60\u00A0Minutenstriche. Jede Minute wandert der lange Zeiger einen Strich weiter.</string>
    <string name="l_kierros_say_hour">60\u00A0Minuten ergeben eine Stunde.</string>
    <string name="l_kierros_q">Wie viel Zeit vergeht, wenn der lange Zeiger einmal ganz herumwandert?</string>
    <string name="l_kierros_c1">Eine Stunde</string>
    <string name="l_kierros_c2">Eine Minute</string>
    <string name="l_kierros_c3">Ein Tag</string>
    <string name="l_kierros_hint">Der kurze Zeiger ist eine Zahl weitergewandert. Das ist eine Stunde.</string>

    <string name="l_tasan_title">Volle Stunden</string>
    <string name="l_tasan_desc">Der lange Zeiger zeigt nach oben</string>
    <string name="l_tasan_p1a">Wenn der lange Zeiger genau nach oben auf die 12 zeigt, ist es eine volle Stunde.</string>
    <string name="l_tasan_p2a">Schau auf den kurzen Zeiger, um die Stunde abzulesen.</string>
    <string name="l_tasan_p2b">Hier zeigt er auf die 3. Es ist also drei Uhr.</string>
    <string name="l_tasan_p3a">Entdecken wir noch andere volle Stunden.</string>
    <string name="l_tasan_p3b">Der lange Zeiger bleibt oben. Der kurze Zeiger verrät uns die Stunde.</string>
    <string name="l_tasan_q">Wie spät ist es?</string>
    <string name="l_tasan_c1">Neun Uhr</string>
    <string name="l_tasan_c2">Zwölf Uhr</string>
    <string name="l_tasan_c3">Drei Uhr</string>
    <string name="l_tasan_hint">Der lange Zeiger steht oben. Lies die Stunde am kurzen rosa Zeiger ab.</string>

    <string name="l_puoli_title">Halbe Stunden</string>
    <string name="l_puoli_desc">Der lange Zeiger zeigt nach unten</string>
    <string name="l_puoli_p1a">Nach einer halben Runde zeigt der lange Zeiger nach unten auf die 6.</string>
    <string name="l_puoli_p1b">Eine halbe Stunde ist vergangen. Das sind 30\u00A0Minuten.</string>
    <string name="l_puoli_say_half">Eine halbe Stunde ist vergangen.</string>
    <string name="l_puoli_p2a">Der kurze Zeiger ist schon an der 3 vorbei, aber noch nicht bei der 4.</string>
    <string name="l_puoli_p2b">Er steht genau in der Mitte dazwischen.</string>
    <string name="l_puoli_p3a">Wir sagen halb vier: Die Hälfte der Stunde bis vier Uhr ist vergangen.</string>
    <string name="l_puoli_p3b">In Zahlen ist das 3:30.</string>
    <string name="l_puoli_say_digits">Halb vier ist 3:30.</string>
    <string name="l_puoli_p4a">Nach halb nennen wir die nächste Stunde, auf die der kurze Zeiger zuwandert.</string>
    <string name="l_puoli_p4b">Zwischen 7 und 8 ist es halb acht.</string>
    <string name="l_puoli_q">Wie spät ist es?</string>
    <string name="l_puoli_c1">Halb sechs</string>
    <string name="l_puoli_c2">Halb fünf</string>
    <string name="l_puoli_c3">Sechs Uhr</string>
    <string name="l_puoli_hint">Der kurze Zeiger steht zwischen 5 und 6. Nenne die nächste Stunde: sechs.</string>

    <string name="l_vartti_title">Viertelstunden</string>
    <string name="l_vartti_desc">Ein Viertel einer Stunde</string>
    <string name="l_vartti_p1a">Teile eine Stunde in vier gleich große Teile. Jeder Teil ist eine Viertelstunde.</string>
    <string name="l_vartti_p1b">Eine Viertelstunde sind 15\u00A0Minuten.</string>
    <string name="l_vartti_say_four">Vier Viertel ergeben eine Stunde.</string>
    <string name="l_vartti_p2a">Wenn der lange Zeiger die 3 erreicht, ist eine Viertelstunde vergangen.</string>
    <string name="l_vartti_p2b">Hier sagen wir Viertel nach drei.</string>
    <string name="l_vartti_p3a">Wenn der lange Zeiger die 9 erreicht, fehlt noch eine Viertelstunde bis zur nächsten vollen Stunde.</string>
    <string name="l_vartti_p3b">Hier sagen wir Viertel vor vier.</string>
    <string name="l_vartti_q">Wie spät ist es?</string>
    <string name="l_vartti_c1">Viertel vor sieben</string>
    <string name="l_vartti_c2">Viertel nach sechs</string>
    <string name="l_vartti_c3">Viertel vor sechs</string>
    <string name="l_vartti_hint">Der lange Zeiger steht auf der 9. Es fehlt noch eine Viertelstunde. Welche Stunde kommt als Nächstes?</string>

    <string name="l_ylivaille_title">Nach und vor</string>
    <string name="l_ylivaille_desc">Zwei Seiten der Uhr</string>
    <string name="l_ylivaille_p1a">Auf der rechten Seite sagen wir zum Beispiel zwanzig nach.</string>
    <string name="l_ylivaille_p1b">Wir zählen die Minuten seit der vollen Stunde.</string>
    <string name="l_ylivaille_p2a">Auf der linken Seite sagen wir zum Beispiel zwanzig vor.</string>
    <string name="l_ylivaille_p2b">Wir zählen die Minuten bis zur nächsten vollen Stunde.</string>
    <!-- Correct grammar: "an der" refers to "die Stunde"; the next "der" belongs to "der kurze Zeiger". -->
    <string name="l_ylivaille_p3a" tools:ignore="Typos">Bei zehn nach nennen wir die Stunde, an der der kurze Zeiger schon vorbei ist.</string>
    <string name="l_ylivaille_p3b">Bei zehn vor nennen wir die nächste Stunde. Nahe der halben Stunde können wir auch die Minuten vor oder nach halb zählen.</string>
    <string name="l_ylivaille_q">Wie spät ist es?</string>
    <string name="l_ylivaille_c1">Zehn nach vier</string>
    <string name="l_ylivaille_c2">Zehn vor vier</string>
    <string name="l_ylivaille_c3">Zehn vor fünf</string>
    <!-- Correct grammar: "an der" refers to "die Stunde"; the next "der" belongs to "der kurze Zeiger". -->
    <string name="l_ylivaille_hint" tools:ignore="Typos">Der lange Zeiger steht rechts. Zähle die Minuten nach der Stunde, an der der kurze Zeiger schon vorbei ist.</string>

    <string name="l_viisi_title">Fünf-Minuten-Schritte</string>
    <string name="l_viisi_desc">Zahlen und Minuten</string>
    <string name="l_viisi_p1a">Der lange Zeiger braucht von einer Zahl zur nächsten immer fünf Minuten.</string>
    <string name="l_viisi_p1b">Die 1 steht für 5\u00A0Minuten, die 2 für 10 und so weiter.</string>
    <string name="l_viisi_p2a">Zähle in Fünferschritten: 5, 10, 15, 20.</string>
    <string name="l_viisi_p2b">Bei der 4 sind 20\u00A0Minuten vergangen. Wir sagen zwanzig nach.</string>
    <string name="l_viisi_p3a">Zähle vor und nach der halben Stunde in Fünferschritten weiter.</string>
    <string name="l_viisi_p3b">Bei der 5 sagen wir fünf vor halb, bei der 7 fünf nach halb. Nach halb nennen wir die nächste Stunde.</string>
    <string name="l_viisi_q">Wie spät ist es?</string>
    <string name="l_viisi_c1">Zwanzig vor neun</string>
    <string name="l_viisi_c2">Zwanzig nach acht</string>
    <string name="l_viisi_c3">Zehn vor neun</string>
    <string name="l_viisi_hint">Bei der 8 sind 40\u00A0Minuten vergangen. Bis zur nächsten Stunde fehlen noch 20\u00A0Minuten.</string>

    <string name="l_minuutit_title">Genaue Minuten</string>
    <string name="l_minuutit_desc">Die kleinen Striche</string>
    <string name="l_minuutit_p1a">Jeder kleine Strich am Rand der Uhr steht für eine Minute.</string>
    <string name="l_minuutit_p1b">Zwischen benachbarten Zahlen liegen 5\u00A0Minuten.</string>
