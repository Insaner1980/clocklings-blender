<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_launcher_foreground">
    <target android:name="right_hand">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="35"
                android:valueType="floatType" android:duration="150" android:repeatCount="5" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
    <target android:name="body">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-5"
                android:valueType="floatType" android:duration="225" android:repeatCount="3" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
